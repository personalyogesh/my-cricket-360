# Local development — copy values into /workspace/.env (never commit .env)
# Supabase project: mycricket360 (org: personalyogesh) — reuse; do not create another.

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8400
# From Supabase → Project Settings → API (publishable only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

MC360_ENV=local
# Verify DB name in Supabase → Settings → Database (often "postgres", NOT "mycricket360")
# Leave SQLite for offline local work, or point at the mycricket360 Postgres when ready:
MC360_DATABASE_URL=sqlite+pysqlite:///./mc360-local.db
# MC360_DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
MC360_CORS_ORIGINS=http://localhost:43123,http://127.0.0.1:43123,http://starks.localhost:43123,http://steelers.localhost:43123
MC360_AUTH_MODE=auto
MC360_DEV_JWT_SECRET=replace-with-long-local-dev-secret-at-least-32-chars
MC360_STORAGE_BACKEND=auto
MC360_LOCAL_STORAGE_DIR=.local-storage
MC360_MAX_UPLOAD_BYTES=2000000

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
# Server-only — never expose to Next.js or iOS
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=sponsor-assets
# Optional explicit overrides (defaults derived from SUPABASE_URL):
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
