# Staging — same Supabase project mycricket360 unless you later split projects.
# Fill from Supabase dashboard; never commit real values.

NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_API_BASE_URL=https://api.staging.example.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

MC360_ENV=staging
# DB name from Settings → Database (verify; do not use project name mycricket360 as DB name)
MC360_DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/VERIFY_DB_NAME
MC360_CORS_ORIGINS=https://starks.staging.example.com,https://steelers.staging.example.com
MC360_AUTH_MODE=supabase
MC360_STORAGE_BACKEND=supabase
MC360_MAX_UPLOAD_BYTES=2000000

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=sponsor-assets
