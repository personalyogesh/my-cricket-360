# Copy to `.env` and fill from Supabase project **mycricket360** (org: personalyogesh).
# Prefer config/environments/local.env.example — see config/SUPABASE.md
# Never commit `.env` or real credentials.

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8400
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer publishable; legacy anon also accepted by @supabase/supabase-js
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

MC360_ENV=local
# Verify Postgres DB name in Settings → Database (often postgres — NOT mycricket360)
MC360_DATABASE_URL=sqlite+pysqlite:///./mc360-local.db
MC360_CORS_ORIGINS=http://localhost:43123,http://127.0.0.1:43123,http://starks.localhost:43123,http://steelers.localhost:43123
MC360_AUTH_MODE=auto
MC360_DEV_JWT_SECRET=replace-with-long-local-dev-secret-at-least-32-chars
MC360_STORAGE_BACKEND=auto
MC360_LOCAL_STORAGE_DIR=.local-storage
MC360_MAX_UPLOAD_BYTES=2000000

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Server-only
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=sponsor-assets
SUPABASE_PROJECT_NAME=mycricket360
SUPABASE_ORG_SLUG=personalyogesh
