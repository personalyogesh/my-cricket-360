# Shared local defaults (copy to .env — never commit secrets)

# Web
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8400

# API
MC360_ENV=local
MC360_DATABASE_URL=postgresql+psycopg://mc360:mc360@127.0.0.1:5433/mc360
MC360_CORS_ORIGINS=http://localhost:43123,http://starks.localhost:43123,http://steelers.localhost:43123

# Supabase (leave empty for local mock / later wiring)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
