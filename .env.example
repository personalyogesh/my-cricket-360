# Shared local defaults (copy to .env — never commit secrets)

# Web
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8400
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API
MC360_ENV=local
# Prefer Postgres when Docker is available:
# MC360_DATABASE_URL=postgresql+psycopg://mc360:mc360@127.0.0.1:5433/mc360
MC360_DATABASE_URL=sqlite+pysqlite:///./mc360-local.db
MC360_CORS_ORIGINS=http://localhost:43123,http://127.0.0.1:43123,http://starks.localhost:43123,http://steelers.localhost:43123
MC360_AUTH_MODE=auto
MC360_DEV_JWT_SECRET=replace-with-long-local-dev-secret-at-least-32-chars
MC360_STORAGE_BACKEND=auto
MC360_LOCAL_STORAGE_DIR=.local-storage
MC360_MAX_UPLOAD_BYTES=2000000

# Supabase (API JWT validation + Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional overrides (defaults derived from SUPABASE_URL):
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=sponsor-assets
